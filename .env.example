# API key from https://berget.ai (required)
BERGET_API_KEY=

# Server port
PORT=3000

# Public URL that the QR code points to (use https://your-domain in production)
PUBLIC_URL=http://localhost:3000

# Models (klang/pianissimo is trained for Swedish)
TRANSCRIBE_MODEL=klang/pianissimo
TRANSLATE_MODEL=google/gemma-4-31B-it

# Styckebrytning ("mellanrum") vid tystnad: bryt alltid vid pauser >= 2000 ms,
# kortare pauser bedöms av System One (berget/bev)
BREAK_LONG_SILENCE_MS=2000
SYSTEMONE_MODEL=berget/bev

# Ingest-API (valfritt): låter externa producenter (t.ex. mötesbotten) pusha
# färdigtranskriberade segment + insikter via POST /api/sessions/:id/segments
# och /insights (Authorization: Bearer ...). Osatt = endpoints avstängda (404).
# Använd en egen nyckel här – ALDRIG BERGET_API_KEY.
INGEST_API_KEY=
